# Copy this file to backend/.env and fill in the values. Get them from the team privately.
# .env is gitignored: never commit real credentials.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Supabase Project Settings > API: the project URL (no trailing slash) and the anon public key.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
